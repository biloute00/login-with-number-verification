# Config for basic_flow_test.py - copy to .env and fill in with values from
# your operator onboarding (e.g. the Orange CAMARA sandbox), then:
#   set -a && source .env && set +a

# OAuth client registered with the operator for this app
CLIENT_ID=
# Only needed for a confidential client; omit for a public client using PKCE only
CLIENT_SECRET=

# Must match a redirect URI registered with the operator. Host/port here
# must be reachable by the browser used in step 1 of the script.
REDIRECT_URI=http://localhost:8743/callback

# Either set OPENID_CONFIG_URL for discovery...
OPENID_CONFIG_URL=
# ...or set these two directly if discovery isn't available
AUTHORIZATION_ENDPOINT=
TOKEN_ENDPOINT=

# apiRoot from the Number Verification spec, e.g. https://api.orange.com/camara/ofr
API_ROOT=

# Space-separated OIDC scopes to request
SCOPE=openid number-verification:verify number-verification:device-phone-number:read

# Phone number to pass to /verify, E.164 format
TEST_PHONE_NUMBER=+34600000000
