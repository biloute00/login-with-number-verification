# Config for the login demo app (app/config.py is the single file that reads
# these - nothing else in the app should hold these values directly).
# Copy to .env and fill in with values from your operator onboarding, then
# e.g.: set -a && source .env && set +a && uvicorn app.main:app --reload
#
# In production (per the task), set these as GitHub-side environment
# variables instead of committing a .env file.

# OAuth client registered with the operator for this app
CLIENT_ID=
# Only needed for a confidential client; omit for a public client using PKCE only
CLIENT_SECRET=

# For operators requiring private_key_jwt client authentication instead of a
# client_secret (e.g. Orange's "JWT assertion" JWKS requirement). Takes
# priority over CLIENT_SECRET when set. PEM-encoded private key whose public
# half was registered with the operator as a JWKS; "\n" may be used in place
# of real newlines to keep this a single-line value.
CLIENT_ASSERTION_PRIVATE_KEY=
# Must match the "kid" of the corresponding key in that JWKS
CLIENT_ASSERTION_KID=

# No REDIRECT_URI here - the app builds it from each request's own host
# (see app/main.py), so locally it's http://localhost:8000/callback
# automatically. Register that same URL with the operator for local
# testing, and whatever https://<host>/callback this app runs under for
# everything else.

# Either set OPENID_CONFIG_URL for discovery...
OPENID_CONFIG_URL=
# ...or set these two directly if discovery isn't available
AUTHORIZATION_ENDPOINT=
TOKEN_ENDPOINT=

# apiRoot from the Number Verification spec, e.g. https://api.orange.com/camara/ofr
API_ROOT=
